{
  "name": "free-fire-esports-hq-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Free Fire Esports HQ backend: Fastify HTTP API + reminder/recurrence workers + Discord bot.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker:reminder": "tsx --env-file-if-exists=.env src/workers/reminder-worker.ts",
    "worker:recurrence": "tsx --env-file-if-exists=.env src/workers/recurrence-worker.ts",
    "bot:discord": "tsx --env-file-if-exists=.env src/workers/discord-bot.ts",
    "keep-alive": "tsx --env-file-if-exists=.env scripts/keep-alive.ts",
    "generate-vapid": "tsx scripts/generate-vapid.ts"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/swagger": "8.15.0",
    "@fastify/swagger-ui": "4.1.0",
    "@supabase/supabase-js": "2.45.4",
    "discord.js": "14.16.3",
    "fastify": "4.28.1",
    "fastify-plugin": "4.5.1",
    "fastify-type-provider-zod": "2.1.0",
    "node-ical": "0.20.1",
    "nodemailer": "6.9.15",
    "pino": "9.4.0",
    "web-push": "3.6.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "@types/nodemailer": "6.4.16",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "2.1.2",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  },
  "overrides": {
    "zod-to-json-schema": "3.23.5"
  }
}
