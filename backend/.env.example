# ---------------------------------------------------------------------------
# Free Fire Esports HQ - backend environment (placeholders only; no real secrets)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase ------------------------------------------------------------------
# Project: free-fire-esports-hq (ref: pivamlbexbpnlqbhqljm, region ap-southeast-1)
SUPABASE_URL=https://pivamlbexbpnlqbhqljm.supabase.co
# Publishable (anon) key - safe for clients and for per-request user context.
SUPABASE_ANON_KEY=replace_me_publishable_or_anon_key
# Service-role key - SERVER ONLY. Required for the reminder/recurrence worker,
# notification delivery, and privileged operations. Never ship to clients.
SUPABASE_SERVICE_ROLE_KEY=replace_me_service_role_key
# Direct Postgres connection - only if you run db integration tests locally.
# DATABASE_URL=postgresql://postgres:[password]@db.pivamlbexbpnlqbhqljm.supabase.co:5432/postgres

# Web Push (VAPID) ----------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=replace_me_vapid_public_key
WEB_PUSH_PRIVATE_KEY=replace_me_vapid_private_key
WEB_PUSH_SUBJECT=mailto:ops@freefirehq.example

# Email provider (SMTP or API) ----------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM=notifications@freefirehq.example
SMTP_HOST=replace_me
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me

# Discord bot (separate worker process) -------------------------------------
DISCORD_BOT_TOKEN=replace_me_bot_token
DISCORD_CLIENT_ID=replace_me_client_id
# Only if an OAuth flow is implemented:
DISCORD_CLIENT_SECRET=replace_me_client_secret

# Worker / scheduler --------------------------------------------------------
# Rolling generation horizon for recurring occurrences (days).
RECURRENCE_HORIZON_DAYS=30
# How often the local worker polls for due reminder jobs (ms). Supabase Cron
# is the primary scheduler in production; this is for the standalone worker.
REMINDER_POLL_INTERVAL_MS=30000
REMINDER_BATCH_SIZE=50
# Shared secret for internal worker endpoints (service-to-service auth).
INTERNAL_WORKER_SECRET=replace_me_long_random_string

# Rate limiting -------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Keep-alive pinger (optional; see scripts/keep-alive.ts) -------------------
# Full readiness URL of the DEPLOYED api, used by `npm run keep-alive` and the
# GitHub Actions workflow. Pinging /ready also touches the DB so Supabase stays
# active. Leave blank in local dev.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MS=600000

# Testing -------------------------------------------------------------------
# When true, the notification layer uses an in-memory fake provider (no real sends).
USE_FAKE_NOTIFICATIONS=true
